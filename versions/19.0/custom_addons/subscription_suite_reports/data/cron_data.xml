<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_generate_subscription_mrr_snapshot" model="ir.cron">
            <field name="name">Subscription: Generate MRR Snapshot</field>
            <field name="model_id" ref="model_subscription_mrr_snapshot"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=55, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
