<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_mrr_snapshot_list" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.list</field>
        <field name="model">subscription.mrr.snapshot</field>
        <field name="arch" type="xml">
            <list string="MRR Snapshots" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_generate_wizard"
                            type="object"
                            string="Generate Snapshot"
                            class="btn-primary"
                            groups="subscription_suite.group_subscription_manager"/>
                </header>
                <field name="snapshot_date"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="subscription_count" sum="Subscriptions"/>
                <field name="active_count" sum="Active"/>
                <field name="trial_count" sum="Trial"/>
                <field name="paused_count" sum="Paused"/>
                <field name="past_due_count" sum="Past Due"/>
                <field name="churned_count" sum="Churned"/>
                <field name="total_recurring_mrr" sum="Total Recurring MRR"/>
                <field name="active_mrr" sum="Active MRR"/>
                <field name="trial_mrr" sum="Trial MRR"/>
                <field name="paused_mrr" sum="Paused MRR"/>
                <field name="past_due_mrr" sum="Past Due MRR"/>
                <field name="churned_mrr" sum="Churned MRR"/>
                <field name="arr" sum="ARR"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_mrr_snapshot_form" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.form</field>
        <field name="model">subscription.mrr.snapshot</field>
        <field name="arch" type="xml">
            <form string="MRR Snapshot" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="snapshot_date"/>
                            <field name="subscription_plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="generated_at"/>
                        </group>
                        <group string="Counts">
                            <field name="subscription_count"/>
                            <field name="active_count"/>
                            <field name="trial_count"/>
                            <field name="paused_count"/>
                            <field name="past_due_count"/>
                            <field name="cancelled_count"/>
                            <field name="expired_count"/>
                            <field name="churned_count"/>
                        </group>
                    </group>
                    <group string="MRR">
                        <field name="total_recurring_mrr" widget="monetary"/>
                        <field name="active_mrr" widget="monetary"/>
                        <field name="trial_mrr" widget="monetary"/>
                        <field name="paused_mrr" widget="monetary"/>
                        <field name="past_due_mrr" widget="monetary"/>
                        <field name="churned_mrr" widget="monetary"/>
                        <field name="arr" widget="monetary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_mrr_snapshot_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.pivot</field>
        <field name="model">subscription.mrr.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="MRR Snapshot Analysis" sample="1">
                <field name="snapshot_date" type="row" interval="month"/>
                <field name="subscription_plan_id" type="col"/>
                <field name="total_recurring_mrr" type="measure"/>
                <field name="active_mrr" type="measure"/>
                <field name="trial_mrr" type="measure"/>
                <field name="paused_mrr" type="measure"/>
                <field name="past_due_mrr" type="measure"/>
                <field name="churned_mrr" type="measure"/>
                <field name="arr" type="measure"/>
                <field name="subscription_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_mrr_snapshot_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.graph</field>
        <field name="model">subscription.mrr.snapshot</field>
        <field name="arch" type="xml">
            <graph string="MRR Snapshots" type="line" sample="1">
                <field name="snapshot_date" interval="month"/>
                <field name="total_recurring_mrr" type="measure"/>
                <field name="active_mrr" type="measure"/>
                <field name="past_due_mrr" type="measure"/>
                <field name="churned_mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_snapshot_search" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.search</field>
        <field name="model">subscription.mrr.snapshot</field>
        <field name="arch" type="xml">
            <search string="MRR Snapshots">
                <field name="snapshot_date"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>

                <filter string="Today" name="today" domain="[('snapshot_date', '=', context_today())]"/>
                <filter string="This Month" name="this_month" domain="[('snapshot_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Has Past Due MRR" name="has_past_due_mrr" domain="[('past_due_mrr', '&gt;', 0)]"/>
                <filter string="Has Churned MRR" name="has_churned_mrr" domain="[('churned_mrr', '&gt;', 0)]"/>
                <separator/>

                <filter string="Snapshot Month" name="group_snapshot_month" context="{'group_by':'snapshot_date:month'}"/>
                <filter string="Snapshot Date" name="group_snapshot_date" context="{'group_by':'snapshot_date'}"/>
                <filter string="Plan" name="group_plan_id" context="{'group_by':'subscription_plan_id'}"/>
                <filter string="Currency" name="group_currency_id" context="{'group_by':'currency_id'}"/>
                <filter string="Company" name="group_company_id" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_subscription_mrr_snapshot_generate_wizard_form" model="ir.ui.view">
        <field name="name">subscription.mrr.snapshot.generate.wizard.form</field>
        <field name="model">subscription.mrr.snapshot.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate MRR Snapshot">
                <group>
                    <field name="snapshot_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_generate_snapshot" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_mrr_snapshot_report" model="ir.actions.act_window">
        <field name="name">MRR Snapshots</field>
        <field name="res_model">subscription.mrr.snapshot</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_group_snapshot_month': 1, 'search_default_group_plan_id': 1}</field>
    </record>

    <record id="action_generate_subscription_mrr_snapshot" model="ir.actions.act_window">
        <field name="name">Generate MRR Snapshot</field>
        <field name="res_model">subscription.mrr.snapshot.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
