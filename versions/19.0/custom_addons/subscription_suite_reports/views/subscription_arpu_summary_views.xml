<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_arpu_summary_list" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.list</field>
        <field name="model">subscription.arpu.summary</field>
        <field name="arch" type="xml">
            <list string="ARPU Summary" create="0" edit="0"
                  decoration-success="status == 'ready'"
                  decoration-warning="status != 'ready'">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <field name="status"/>
                <field name="opening_subscription_count" sum="Opening Subscriptions"/>
                <field name="closing_subscription_count" sum="Closing Subscriptions"/>
                <field name="average_subscription_count" sum="Average Subscriptions"/>
                <field name="opening_mrr" widget="monetary" sum="Opening MRR"/>
                <field name="closing_mrr" widget="monetary" sum="Closing MRR"/>
                <field name="average_mrr" widget="monetary" sum="Average MRR"/>
                <field name="arpu" widget="monetary" avg="Average ARPU"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_arpu_summary_form" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.form</field>
        <field name="model">subscription.arpu.summary</field>
        <field name="arch" type="xml">
            <form string="ARPU Summary" create="0" edit="0">
                <header>
                    <button name="action_view_snapshots" type="object" string="Snapshots" class="btn-primary"/>
                    <button name="action_view_source_subscriptions" type="object" string="Subscriptions"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="arpu" widget="monetary"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="subscription_plan_id"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ready'"
                                   decoration-warning="status != 'ready'"/>
                            <field name="generated_at"/>
                        </group>
                    </group>
                    <group string="Subscriptions">
                        <field name="opening_subscription_count"/>
                        <field name="closing_subscription_count"/>
                        <field name="average_subscription_count"/>
                    </group>
                    <group string="MRR And ARPU">
                        <field name="opening_mrr" widget="monetary"/>
                        <field name="closing_mrr" widget="monetary"/>
                        <field name="average_mrr" widget="monetary"/>
                        <field name="arpu" widget="monetary"/>
                    </group>
                    <group string="Technical">
                        <field name="bucket_key"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_arpu_summary_pivot" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.pivot</field>
        <field name="model">subscription.arpu.summary</field>
        <field name="arch" type="xml">
            <pivot string="ARPU Summary" sample="1">
                <field name="closing_date" type="row"/>
                <field name="subscription_plan_id" type="col"/>
                <field name="arpu" type="measure"/>
                <field name="average_mrr" type="measure"/>
                <field name="average_subscription_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_arpu_summary_graph" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.graph</field>
        <field name="model">subscription.arpu.summary</field>
        <field name="arch" type="xml">
            <graph string="ARPU Summary" type="line" sample="1">
                <field name="closing_date"/>
                <field name="arpu" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_arpu_summary_search" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.search</field>
        <field name="model">subscription.arpu.summary</field>
        <field name="arch" type="xml">
            <search string="ARPU Summary">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <field name="status"/>
                <filter string="Ready" name="ready" domain="[('status', '=', 'ready')]"/>
                <filter string="Missing Opening Snapshot" name="missing_opening" domain="[('status', '=', 'missing_opening_snapshot')]"/>
                <filter string="Missing Closing Snapshot" name="missing_closing" domain="[('status', '=', 'missing_closing_snapshot')]"/>
                <group>
                    <filter string="Closing Date" name="group_closing_date" context="{'group_by': 'closing_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'subscription_plan_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_subscription_arpu_summary_generate_wizard_form" model="ir.ui.view">
        <field name="name">subscription.arpu.summary.generate.wizard.form</field>
        <field name="model">subscription.arpu.summary.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate ARPU Summary">
                <group>
                    <field name="opening_date"/>
                    <field name="closing_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="subscription_plan_id"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_arpu_summary_report" model="ir.actions.act_window">
        <field name="name">ARPU Summary</field>
        <field name="res_model">subscription.arpu.summary</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_subscription_arpu_summary_search"/>
        <field name="context">{'search_default_group_closing_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate ARPU summaries from opening and closing MRR snapshots.
            </p>
        </field>
    </record>

    <record id="action_generate_subscription_arpu_summary" model="ir.actions.act_window">
        <field name="name">Generate ARPU Summary</field>
        <field name="res_model">subscription.arpu.summary.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
