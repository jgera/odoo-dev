<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_mrr_movement_list" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.list</field>
        <field name="model">subscription.mrr.movement</field>
        <field name="arch" type="xml">
            <list string="MRR Movements" create="0" edit="0" delete="0">
                <field name="movement_date"/>
                <field name="movement_type"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="subscription_plan_id"/>
                <field name="user_id"/>
                <field name="previous_mrr" sum="Previous MRR"/>
                <field name="new_mrr" sum="New MRR"/>
                <field name="amount" sum="Net Movement"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.pivot</field>
        <field name="model">subscription.mrr.movement</field>
        <field name="arch" type="xml">
            <pivot string="MRR Movement Analysis" sample="1">
                <field name="movement_date" type="row" interval="month"/>
                <field name="movement_type" type="col"/>
                <field name="amount" type="measure"/>
                <field name="previous_mrr" type="measure"/>
                <field name="new_mrr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.graph</field>
        <field name="model">subscription.mrr.movement</field>
        <field name="arch" type="xml">
            <graph string="MRR Movements" type="bar" sample="1">
                <field name="movement_date" interval="month"/>
                <field name="movement_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_search" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.search</field>
        <field name="model">subscription.mrr.movement</field>
        <field name="arch" type="xml">
            <search string="MRR Movements">
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="subscription_plan_id"/>
                <field name="user_id"/>
                <field name="cancellation_reason_id"/>

                <filter string="New MRR" name="new_mrr" domain="[('movement_type', '=', 'new')]"/>
                <filter string="Expansion" name="expansion" domain="[('movement_type', '=', 'expansion')]"/>
                <filter string="Contraction" name="contraction" domain="[('movement_type', '=', 'contraction')]"/>
                <filter string="Churn" name="churn" domain="[('movement_type', '=', 'churn')]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('movement_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>

                <filter string="Movement Type" name="group_movement_type" context="{'group_by':'movement_type'}"/>
                <filter string="Movement Month" name="group_movement_month" context="{'group_by':'movement_date:month'}"/>
                <filter string="Salesperson" name="group_user_id" context="{'group_by':'user_id'}"/>
                <filter string="Plan" name="group_plan_id" context="{'group_by':'subscription_plan_id'}"/>
                <filter string="Customer" name="group_partner_id" context="{'group_by':'partner_id'}"/>
                <filter string="Cancellation Reason" name="group_cancellation_reason_id" context="{'group_by':'cancellation_reason_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_subscription_mrr_movement_report" model="ir.actions.act_window">
        <field name="name">MRR Movements</field>
        <field name="res_model">subscription.mrr.movement</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_movement_month': 1, 'search_default_group_movement_type': 1}</field>
    </record>
</odoo>
