<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_subscription_code" model="ir.sequence">
            <field name="name">Subscription Code</field>
            <field name="code">subscription.code</field>
            <field name="prefix">SUB-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_subscription_cancellation_request" model="ir.sequence">
            <field name="name">Subscription Cancellation Request</field>
            <field name="code">subscription.cancellation.request</field>
            <field name="prefix">SCR-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="sequence_subscription_lifecycle_request" model="ir.sequence">
            <field name="name">Subscription Lifecycle Request</field>
            <field name="code">subscription.lifecycle.request</field>
            <field name="prefix">SLR-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
