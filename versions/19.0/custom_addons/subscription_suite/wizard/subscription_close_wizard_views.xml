<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_close_wizard_form" model="ir.ui.view">
        <field name="name">subscription.close.wizard.form</field>
        <field name="model">subscription.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Subscription">
                <group>
                    <field name="subscription_id"/>
                    <field name="cancel_reason_id"/>
                    <field name="cancel_date"/>
                    <field name="cancellation_policy"/>
                    <field name="feedback" placeholder="Additional feedback from the customer..."/>
                </group>
                <div class="alert alert-warning" role="alert" invisible="cancellation_policy != 'end_of_period'">
                    This subscription is configured to cancel at the end of the billing period.
                </div>
                <footer>
                    <button name="action_cancel" type="object" string="Confirm Cancellation" class="btn-danger"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
