<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="default_dunning_policy" model="subscription.dunning.policy">
            <field name="name">Standard 14-Day Cancellation</field>
            <field name="grace_period_days">1</field>
            <field name="final_action">cancel</field>
            <field name="final_action_delay">7</field>
        </record>

        <record id="default_dunning_line_1" model="subscription.dunning.policy.line">
            <field name="policy_id" ref="default_dunning_policy"/>
            <field name="delay_days">1</field>
            <field name="action_type">email</field>
            <field name="email_template_id" ref="email_template_dunning_1"/>
        </record>

        <record id="default_dunning_line_2" model="subscription.dunning.policy.line">
            <field name="policy_id" ref="default_dunning_policy"/>
            <field name="delay_days">3</field>
            <field name="action_type">email</field>
            <field name="email_template_id" ref="email_template_dunning_2"/>
        </record>

        <record id="default_dunning_line_3" model="subscription.dunning.policy.line">
            <field name="policy_id" ref="default_dunning_policy"/>
            <field name="delay_days">7</field>
            <field name="action_type">email</field>
            <field name="email_template_id" ref="email_template_dunning_3"/>
        </record>
    </data>
</odoo>
