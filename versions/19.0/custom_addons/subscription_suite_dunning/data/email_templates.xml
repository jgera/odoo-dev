<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_dunning_1" model="mail.template">
            <field name="name">Subscription: Payment Failed (Day 1)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Action Required: Payment failed for your subscription {{ object.subscription_code }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email) }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or 'Customer'"/>,<br/><br/>
        We were unable to process the latest payment for your subscription <strong><t t-out="object.subscription_code"/></strong>.<br/><br/>
        Please update your payment method to ensure uninterrupted service.<br/><br/>
        If you have any questions, please contact us.<br/><br/>
        Best regards,<br/>
        <t t-out="object.company_id.name"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="email_template_dunning_2" model="mail.template">
            <field name="name">Subscription: Payment Failed Reminder (Day 3)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Reminder: Please update payment for {{ object.subscription_code }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email) }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or 'Customer'"/>,<br/><br/>
        This is a reminder that we are still unable to process the payment for your subscription <strong><t t-out="object.subscription_code"/></strong>.<br/><br/>
        Your service may be interrupted if payment is not received soon. Please update your payment details.<br/><br/>
        Best regards,<br/>
        <t t-out="object.company_id.name"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="email_template_dunning_3" model="mail.template">
            <field name="name">Subscription: Final Warning (Day 7)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Final Warning: Subscription {{ object.subscription_code }} will be cancelled</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email) }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or 'Customer'"/>,<br/><br/>
        This is our final notice regarding the failed payment for your subscription <strong><t t-out="object.subscription_code"/></strong>.<br/><br/>
        If we do not receive payment shortly, your subscription will be automatically cancelled or paused.<br/><br/>
        Please take action immediately to avoid service disruption.<br/><br/>
        Best regards,<br/>
        <t t-out="object.company_id.name"/>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
