<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_dunning_attempt_list" model="ir.ui.view">
        <field name="name">subscription.dunning.attempt.list</field>
        <field name="model">subscription.dunning.attempt</field>
        <field name="arch" type="xml">
            <list string="Dunning Attempts" create="0" edit="0" decoration-danger="state == 'failed'" decoration-success="state == 'done'" decoration-warning="state in ('pending', 'sent')" decoration-muted="state == 'skipped'">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="invoice_id" optional="show"/>
                <field name="policy_id"/>
                <field name="policy_line_id" optional="show"/>
                <field name="action_type"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state in ('pending', 'sent')" decoration-muted="state == 'skipped'"/>
                <field name="amount_at_risk" widget="monetary"/>
                <field name="days_since_start" optional="show"/>
                <field name="attempt_date"/>
                <field name="completed_at" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_dunning_attempt_form" model="ir.ui.view">
        <field name="name">subscription.dunning.attempt.form</field>
        <field name="model">subscription.dunning.attempt</field>
        <field name="arch" type="xml">
            <form string="Dunning Attempt" create="0" edit="0">
                <header>
                    <button name="action_open_subscription" type="object" string="Open Subscription"/>
                    <button name="action_open_invoice" type="object" string="Open Invoice" invisible="not invoice_id"/>
                    <button name="action_open_payment_attempt" type="object" string="Open Payment Attempt" invisible="not payment_attempt_id"/>
                    <button name="action_retry_payment" type="object" string="Retry Payment" class="btn-primary"
                            invisible="not invoice_id or action_type in ['final_cancel', 'final_pause', 'final_none']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                            <field name="invoice_id"/>
                            <field name="payment_attempt_id"/>
                        </group>
                        <group>
                            <field name="policy_id"/>
                            <field name="policy_line_id"/>
                            <field name="action_type"/>
                            <field name="email_template_id"/>
                            <field name="mail_mail_id"/>
                        </group>
                    </group>
                    <group string="Manual Retry">
                        <field name="manual_retry_count"/>
                        <field name="last_manual_retry_at"/>
                    </group>
                    <group string="Recovery">
                        <field name="recovery_url"/>
                        <field name="amount_at_risk" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="days_since_start"/>
                    </group>
                    <group>
                        <field name="attempt_date"/>
                        <field name="completed_at"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Notes">
                        <field name="note"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subscription_dunning_attempt_search" model="ir.ui.view">
        <field name="name">subscription.dunning.attempt.search</field>
        <field name="model">subscription.dunning.attempt</field>
        <field name="arch" type="xml">
            <search string="Dunning Attempts">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <field name="policy_id"/>
                <filter string="Pending" name="pending" domain="[('state', 'in', ['pending', 'sent'])]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Final Actions" name="final_actions" domain="[('action_type', 'in', ['final_cancel', 'final_pause', 'final_none'])]"/>
                <filter string="Email Steps" name="email_steps" domain="[('action_type', 'in', ['email', 'email_and_retry'])]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Action" name="group_action_type" context="{'group_by': 'action_type'}"/>
                    <filter string="Policy" name="group_policy" context="{'group_by': 'policy_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Attempt Date" name="group_attempt_date" context="{'group_by': 'attempt_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_dunning_attempt" model="ir.actions.act_window">
        <field name="name">Dunning Attempts</field>
        <field name="res_model">subscription.dunning.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <menuitem id="menu_subscription_dunning_attempt"
              name="Dunning Attempts"
              parent="subscription_suite_billing.menu_subscription_billing"
              action="action_subscription_dunning_attempt"
              sequence="40"/>
</odoo>
