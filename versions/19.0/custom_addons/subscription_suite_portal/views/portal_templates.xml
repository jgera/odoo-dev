<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Subscription to Portal Home Menu -->
    <template id="portal_my_home_menu_subscription" name="Portal layout : subscription menu entries" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'subscription' or subscription" t-attf-class="breadcrumb-item #{'active ' if not subscription else ''}">
                <a t-if="subscription" t-attf-href="/my/subscriptions?{{ keep_query() }}">Subscriptions</a>
                <t t-else="">Subscriptions</t>
            </li>
            <li t-if="subscription" class="breadcrumb-item active">
                <t t-out="subscription.subscription_code"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_subscription" name="Show Subscriptions" inherit_id="portal.portal_my_home" customize_show="True" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="count" t-value="subscription_count"/>
            </t>
        </xpath>
    </template>

    <!-- Subscriptions List View -->
    <template id="portal_my_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>
            <t t-if="not subscriptions">
                <p>There are currently no subscriptions for your account.</p>
            </t>
            <t t-if="subscriptions" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference #</th>
                        <th>Plan</th>
                        <th class="text-end">Plan Change</th>
                        <th class="text-end">Next Invoice</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">MRR</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="subscriptions" t-as="sub">
                        <tr>
                            <td><a t-attf-href="/my/subscription/#{sub.id}"><t t-out="sub.subscription_code or sub.name"/></a></td>
                            <td><t t-out="sub.subscription_plan_id.name"/></td>
                            <td class="text-end">
                                <span t-if="sub.pending_plan_change_id" class="badge text-bg-info">
                                    <t t-out="sub.pending_plan_change_id.name"/>
                                </span>
                                <span t-if="not sub.pending_plan_change_id" class="text-muted">None</span>
                            </td>
                            <td class="text-end"><span t-field="sub.next_invoice_date"/></td>
                            <td class="text-center">
                                <span t-if="sub.subscription_state == 'draft'" class="badge text-bg-light"><i class="fa fa-fw fa-pencil"/> Draft</span>
                                <span t-if="sub.subscription_state == 'active'" class="badge text-bg-success"><i class="fa fa-fw fa-check"/> Active</span>
                                <span t-if="sub.subscription_state == 'trial'" class="badge text-bg-info"><i class="fa fa-fw fa-clock-o"/> Trial</span>
                                <span t-if="sub.subscription_state == 'past_due'" class="badge text-bg-danger"><i class="fa fa-fw fa-exclamation-triangle"/> Past Due</span>
                                <span t-if="sub.subscription_state == 'paused'" class="badge text-bg-warning"><i class="fa fa-fw fa-pause"/> Paused</span>
                                <span t-if="sub.subscription_state == 'cancelled'" class="badge text-bg-secondary"><i class="fa fa-fw fa-times"/> Cancelled</span>
                                <span t-if="sub.subscription_state == 'expired'" class="badge text-bg-secondary"><i class="fa fa-fw fa-calendar-times-o"/> Expired</span>
                            </td>
                            <td class="text-end">
                                <span t-field="sub.mrr" t-options='{"widget": "monetary", "display_currency": sub.currency_id}'/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- Subscription Detailed View -->
    <template id="portal_subscription_page" name="Subscription Details">
        <t t-call="portal.portal_layout">
            <t t-set="subscription" t-value="subscription"/>
            <div id="optional_layout">
                <t t-call="portal.portal_record_layout">
                    <t t-set="card_header">
                        <div class="row g-2 align-items-center">
                            <div class="col-12">
                                <h5 class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-0">
                                    <span class="text-truncate">
                                        <t t-out="subscription.subscription_plan_id.name"/>
                                        <small class="text-muted d-none d-md-inline"> (<t t-out="subscription.subscription_code"/>)</small>
                                    </span>
                                    <span>
                                        <span t-if="subscription.subscription_state == 'draft'" class="badge text-bg-light rounded-pill"><i class="fa fa-fw fa-pencil"/> Draft</span>
                                        <span t-if="subscription.subscription_state == 'active'" class="badge text-bg-success rounded-pill"><i class="fa fa-fw fa-check"/> Active</span>
                                        <span t-if="subscription.subscription_state == 'trial'" class="badge text-bg-info rounded-pill"><i class="fa fa-fw fa-clock-o"/> Trial</span>
                                        <span t-if="subscription.subscription_state == 'past_due'" class="badge text-bg-danger rounded-pill"><i class="fa fa-fw fa-exclamation-triangle"/> Past Due</span>
                                        <span t-if="subscription.subscription_state == 'paused'" class="badge text-bg-warning rounded-pill"><i class="fa fa-fw fa-pause"/> Paused</span>
                                        <span t-if="subscription.subscription_state == 'cancelled'" class="badge text-bg-secondary rounded-pill"><i class="fa fa-fw fa-times"/> Cancelled</span>
                                        <span t-if="subscription.subscription_state == 'expired'" class="badge text-bg-secondary rounded-pill"><i class="fa fa-fw fa-calendar-times-o"/> Expired</span>
                                    </span>
                                </h5>
                            </div>
                        </div>
                    </t>
                    <t t-set="card_body">
                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Monthly Recurring Revenue</div>
                                    <div class="fw-semibold">
                                        <span t-field="subscription.mrr" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Recurring Amount</div>
                                    <div class="fw-semibold">
                                        <span t-field="subscription.recurring_total" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Next Invoice</div>
                                    <div class="fw-semibold">
                                        <span t-field="subscription.next_invoice_date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6 col-lg-3">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Billing Period</div>
                                    <div class="fw-semibold">
                                        Every <span t-field="subscription.billing_interval_count"/> <span t-field="subscription.billing_interval_unit"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-4">
                                <div class="text-muted small">Current Plan</div>
                                <div>
                                    <span t-field="subscription.subscription_plan_id"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted small">Current Period</div>
                                <div>
                                    <span t-field="subscription.current_period_start"/>
                                    <span t-if="subscription.current_period_start or subscription.current_period_end"> - </span>
                                    <span t-field="subscription.current_period_end"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted small">Payment Method</div>
                                <div>
                                    <span t-if="subscription.payment_token_id" t-out="subscription.payment_token_id.display_name"/>
                                    <span t-if="not subscription.payment_token_id" class="text-muted">Not saved</span>
                                </div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted small">Auto-Pay</div>
                                <div>
                                    <span t-if="subscription.is_auto_pay" class="badge text-bg-success">Enabled</span>
                                    <span t-if="not subscription.is_auto_pay" class="badge text-bg-secondary">Off</span>
                                </div>
                            </div>
                        </div>

                        <div t-if="subscription.pending_plan_change_id" class="alert alert-info d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-calendar-check-o mt-1"/>
                            <div>
                                <div class="fw-semibold">Scheduled Plan Change</div>
                                <div>
                                    <span t-field="subscription.pending_plan_change_type"/>
                                    to <span t-field="subscription.pending_plan_change_id"/>
                                    on <span t-field="subscription.pending_plan_change_date"/>.
                                </div>
                            </div>
                        </div>

                        <div t-if="subscription.pending_cancellation" class="alert alert-warning d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-calendar-times-o mt-1"/>
                            <div>
                                <div class="fw-semibold">Scheduled Cancellation</div>
                                <div>
                                    This subscription is scheduled to cancel on
                                    <span t-field="subscription.cancellation_effective_date"/>.
                                </div>
                            </div>
                        </div>

                        <div t-if="plan_change_status == 'requested'" class="alert alert-success d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-check mt-1"/>
                            <div>Plan change request submitted.</div>
                        </div>

                        <div t-if="plan_change_error" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="fa fa-fw fa-exclamation-triangle mt-1"/>
                            <div><t t-out="plan_change_error"/></div>
                        </div>

                        <div t-if="cancellation_status == 'requested'" class="alert alert-success d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-check mt-1"/>
                            <div>Cancellation request submitted.</div>
                        </div>

                        <div t-if="cancellation_error" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="fa fa-fw fa-exclamation-triangle mt-1"/>
                            <div><t t-out="cancellation_error"/></div>
                        </div>

                        <div t-if="lifecycle_status == 'requested'" class="alert alert-success d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-check mt-1"/>
                            <div>Lifecycle request submitted.</div>
                        </div>

                        <div t-if="lifecycle_error" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="fa fa-fw fa-exclamation-triangle mt-1"/>
                            <div><t t-out="lifecycle_error"/></div>
                        </div>

                        <div t-if="payment_status == 'success'" class="alert alert-success d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-check mt-1"/>
                            <div>Payment retry completed. No recovery action is needed for this invoice.</div>
                        </div>

                        <div t-if="payment_status == 'pending'" class="alert alert-info d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-clock-o mt-1"/>
                            <div>Payment retry was submitted. The invoice status will update after the provider confirms the payment.</div>
                        </div>

                        <div t-if="payment_error" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="fa fa-fw fa-exclamation-triangle mt-1"/>
                            <div><t t-out="payment_error"/></div>
                        </div>

                        <div t-if="payment_method_status == 'saved'" class="alert alert-success d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-check mt-1"/>
                            <div>Payment method updated.</div>
                        </div>

                        <div t-if="payment_method_status == 'pending'" class="alert alert-info d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-clock-o mt-1"/>
                            <div>Payment method validation is still pending. Refresh this page after the provider confirms it.</div>
                        </div>

                        <div t-if="payment_method_error" class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <i class="fa fa-fw fa-exclamation-triangle mt-1"/>
                            <div><t t-out="payment_method_error"/></div>
                        </div>

                        <div t-if="payment_recovery and payment_recovery.get('state') == 'missing_payment_method'" class="alert alert-warning d-flex align-items-start gap-2" role="status">
                            <i class="fa fa-fw fa-credit-card mt-1"/>
                            <div>
                                <div class="fw-semibold">Saved payment method required</div>
                                <div><t t-out="payment_recovery.get('message')"/></div>
                                <div class="small text-muted"><t t-out="payment_recovery.get('next_action')"/></div>
                            </div>
                        </div>

                        <div t-if="payment_recovery_invoice" class="alert alert-danger d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between" role="alert">
                            <div class="d-flex align-items-start gap-2">
                                <i class="fa fa-fw fa-credit-card mt-1"/>
                                <div>
                                    <div class="fw-semibold">Payment Recovery Needed</div>
                                    <div>
                                        Invoice <a t-att-href="payment_recovery_invoice.get_portal_url()"><span t-field="payment_recovery_invoice.name"/></a>
                                        has an outstanding balance of
                                        <span t-field="payment_recovery_invoice.amount_residual" t-options='{"widget": "monetary", "display_currency": payment_recovery_invoice.currency_id}'/>
                                        due.
                                    </div>
                                    <div class="small text-muted">
                                        Due date:
                                        <span t-if="payment_recovery_invoice.invoice_date_due" t-field="payment_recovery_invoice.invoice_date_due"/>
                                        <span t-if="not payment_recovery_invoice.invoice_date_due">Not set</span>
                                        <span class="mx-1">|</span>
                                        Status:
                                        <span t-if="payment_recovery_invoice.payment_state == 'not_paid'">Open</span>
                                        <span t-if="payment_recovery_invoice.payment_state == 'partial'">Partially paid</span>
                                        <span t-if="payment_recovery_invoice.payment_state not in ['not_paid', 'partial']" t-field="payment_recovery_invoice.payment_state"/>
                                    </div>
                                    <div t-if="payment_recovery and payment_recovery.get('next_action')" class="small text-muted">
                                        <t t-out="payment_recovery.get('next_action')"/>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-light" t-att-href="payment_recovery_invoice.get_portal_url()">
                                    <i class="fa fa-fw fa-file-text-o"/>
                                    Open Invoice
                                </a>
                                <form t-if="payment_recovery and payment_recovery.get('can_retry')" method="post" t-att-action="'/my/subscription/%s/payment/retry' % subscription.id">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="invoice_id" t-att-value="payment_recovery_invoice.id"/>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-fw fa-refresh"/>
                                        Retry Saved Method
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="border rounded p-3 mb-4">
                            <div class="d-flex flex-column flex-lg-row gap-3 justify-content-between align-items-lg-start">
                                <div>
                                    <h3 class="h5 mb-1">Payment Method</h3>
                                    <div t-if="subscription.payment_token_id" class="text-muted">
                                        <span t-out="subscription.payment_token_id.display_name"/>
                                    </div>
                                    <div t-if="not subscription.payment_token_id" class="text-muted">
                                        No saved method is assigned to this subscription.
                                    </div>
                                </div>
                                <a class="btn btn-outline-primary" t-att-href="'/my/subscription/%s/payment/method' % subscription.id">
                                    <i class="fa fa-fw fa-plus"/>
                                    Add Method
                                </a>
                            </div>
                            <form t-if="payment_tokens" method="post" t-att-action="'/my/subscription/%s/payment/method/select' % subscription.id" class="row g-2 align-items-end mt-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-12 col-md-8">
                                    <label for="token_id" class="form-label">Saved Method</label>
                                    <select id="token_id" name="token_id" class="form-select" required="required">
                                        <option value="">Select a saved method</option>
                                        <option t-foreach="payment_tokens" t-as="payment_token" t-att-value="payment_token.id" t-att-selected="payment_token == subscription.payment_token_id">
                                            <t t-out="payment_token.display_name"/>
                                        </option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-fw fa-check"/>
                                        Use Method
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div
                            t-if="subscription.subscription_state == 'active' and available_plan_change_ids and not subscription.pending_plan_change_id and not pending_plan_change_request and not subscription.pending_cancellation and not pending_cancellation_request and not pending_lifecycle_request"
                            class="border rounded p-3 mb-4"
                        >
                            <h3 class="h5">Request Plan Change</h3>
                            <form method="post" t-att-action="'/my/subscription/%s/plan-change/request' % subscription.id" class="row g-2 align-items-end">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-12 col-md-8">
                                    <label for="new_plan_id" class="form-label">New Plan</label>
                                    <select id="new_plan_id" name="new_plan_id" class="form-select" required="required">
                                        <option value="">Select a plan</option>
                                        <option t-foreach="available_plan_change_ids" t-as="available_plan" t-att-value="available_plan.id">
                                            <t t-out="available_plan.name"/>
                                        </option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="fa fa-fw fa-exchange"/>
                                        Request Change
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div
                            t-if="subscription.subscription_state in ['active', 'paused'] and not pending_lifecycle_request and not subscription.pending_cancellation and not pending_cancellation_request and not pending_plan_change_request"
                            class="border rounded p-3 mb-4"
                        >
                            <h3 class="h5">
                                <t t-if="subscription.subscription_state == 'active'">Request Pause</t>
                                <t t-if="subscription.subscription_state == 'paused'">Request Resume</t>
                            </h3>
                            <form method="post" t-att-action="'/my/subscription/%s/lifecycle/request' % subscription.id" class="row g-2 align-items-end">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input t-if="subscription.subscription_state == 'active'" type="hidden" name="request_type" value="pause"/>
                                <input t-if="subscription.subscription_state == 'paused'" type="hidden" name="request_type" value="resume"/>
                                <div class="col-12 col-md-8">
                                    <label for="lifecycle_feedback" class="form-label">Feedback</label>
                                    <textarea id="lifecycle_feedback" name="feedback" class="form-control" rows="1"></textarea>
                                </div>
                                <div class="col-12 col-md-4">
                                    <button type="submit" class="btn btn-outline-primary w-100">
                                        <i t-if="subscription.subscription_state == 'active'" class="fa fa-fw fa-pause"/>
                                        <i t-if="subscription.subscription_state == 'paused'" class="fa fa-fw fa-play"/>
                                        Submit Request
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div
                            t-if="subscription.subscription_state in ['active', 'trial', 'paused', 'past_due'] and cancellation_reason_ids and not subscription.pending_cancellation and not pending_cancellation_request and not pending_lifecycle_request"
                            class="border rounded p-3 mb-4"
                        >
                            <h3 class="h5">Request Cancellation</h3>
                            <form method="post" t-att-action="'/my/subscription/%s/cancellation/request' % subscription.id" class="row g-2 align-items-end">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-12 col-md-5">
                                    <label for="reason_id" class="form-label">Reason</label>
                                    <select id="reason_id" name="reason_id" class="form-select" required="required">
                                        <option value="">Select a reason</option>
                                        <option t-foreach="cancellation_reason_ids" t-as="cancel_reason" t-att-value="cancel_reason.id">
                                            <t t-out="cancel_reason.name"/>
                                        </option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label for="feedback" class="form-label">Feedback</label>
                                    <textarea id="feedback" name="feedback" class="form-control" rows="1"></textarea>
                                </div>
                                <div class="col-12 col-md-2">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="fa fa-fw fa-times"/>
                                        Request
                                    </button>
                                </div>
                            </form>
                        </div>

                        <h3 t-if="lifecycle_requests" class="h5 mt-4">Lifecycle Requests</h3>
                        <table t-if="lifecycle_requests" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th class="text-center">Action</th>
                                    <th class="text-end">Requested On</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lifecycle_requests" t-as="lifecycle_request">
                                    <td><span t-field="lifecycle_request.name"/></td>
                                    <td class="text-center"><span t-field="lifecycle_request.request_type"/></td>
                                    <td class="text-end"><span t-field="lifecycle_request.requested_on"/></td>
                                    <td class="text-center">
                                        <span t-if="lifecycle_request.state == 'pending'" class="badge text-bg-info">Pending</span>
                                        <span t-if="lifecycle_request.state == 'approved'" class="badge text-bg-success">Approved</span>
                                        <span t-if="lifecycle_request.state == 'rejected'" class="badge text-bg-danger">Rejected</span>
                                        <span t-if="lifecycle_request.state == 'cancelled'" class="badge text-bg-secondary">Cancelled</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3 t-if="plan_change_requests" class="h5 mt-4">Plan Change Requests</h3>
                        <table t-if="plan_change_requests" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th>Requested Plan</th>
                                    <th class="text-center">Type</th>
                                    <th class="text-end">Effective Date</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="plan_change_requests" t-as="plan_request">
                                    <td><span t-field="plan_request.name"/></td>
                                    <td><span t-field="plan_request.requested_plan_id"/></td>
                                    <td class="text-center"><span t-field="plan_request.change_type"/></td>
                                    <td class="text-end"><span t-field="plan_request.requested_effective_date"/></td>
                                    <td class="text-center">
                                        <span t-if="plan_request.state == 'pending'" class="badge text-bg-info">Pending</span>
                                        <span t-if="plan_request.state == 'approved'" class="badge text-bg-success">Approved</span>
                                        <span t-if="plan_request.state == 'rejected'" class="badge text-bg-danger">Rejected</span>
                                        <span t-if="plan_request.state == 'cancelled'" class="badge text-bg-secondary">Cancelled</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3 t-if="cancellation_requests" class="h5 mt-4">Cancellation Requests</h3>
                        <table t-if="cancellation_requests" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Request</th>
                                    <th>Reason</th>
                                    <th class="text-end">Effective Date</th>
                                    <th class="text-center">Policy</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="cancellation_requests" t-as="cancel_request">
                                    <td><span t-field="cancel_request.name"/></td>
                                    <td><span t-field="cancel_request.reason_id"/></td>
                                    <td class="text-end"><span t-field="cancel_request.requested_effective_date"/></td>
                                    <td class="text-center"><span t-field="cancel_request.requested_policy"/></td>
                                    <td class="text-center">
                                        <span t-if="cancel_request.state == 'pending'" class="badge text-bg-info">Pending</span>
                                        <span t-if="cancel_request.state == 'approved'" class="badge text-bg-success">Approved</span>
                                        <span t-if="cancel_request.state == 'rejected'" class="badge text-bg-danger">Rejected</span>
                                        <span t-if="cancel_request.state == 'cancelled'" class="badge text-bg-secondary">Cancelled</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Product Lines -->
                        <h3 class="h5">Subscription Items</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="subscription.order_line.filtered(lambda l: l.is_recurring)" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": subscription.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h3 class="h5 mt-4">Invoice History</h3>
                        <t t-if="not invoices">
                            <p class="text-muted">No invoices have been generated for this subscription yet.</p>
                        </t>
                        <table t-if="invoices" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Invoice</th>
                                    <th class="text-end">Invoice Date</th>
                                    <th class="text-end">Due Date</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="invoices" t-as="invoice">
                                    <td>
                                        <a t-att-href="invoice.get_portal_url()"><span t-field="invoice.name"/></a>
                                    </td>
                                    <td class="text-end"><span t-field="invoice.invoice_date"/></td>
                                    <td class="text-end"><span t-field="invoice.invoice_date_due"/></td>
                                    <td class="text-center">
                                        <span t-if="invoice.payment_state == 'paid'" class="badge text-bg-success">Paid</span>
                                        <span t-if="invoice.payment_state == 'not_paid'" class="badge text-bg-warning">Open</span>
                                        <span t-if="invoice.payment_state == 'partial'" class="badge text-bg-info">Partial</span>
                                        <span t-if="invoice.payment_state == 'in_payment'" class="badge text-bg-info">In Payment</span>
                                        <span t-if="invoice.payment_state in ['reversed', 'blocked']" class="badge text-bg-secondary"><span t-field="invoice.payment_state"/></span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="invoice.amount_total" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <!-- Chatter -->
                <div id="subscription_communication" class="mt-4">
                    <h2>History</h2>
                    <t t-call="portal.message_thread">
                        <t t-set="object" t-value="subscription"/>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
