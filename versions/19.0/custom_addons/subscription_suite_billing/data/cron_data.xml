<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Auto Collect Payments Cron -->
        <record id="cron_auto_collect_subscription_payments" model="ir.cron">
            <field name="name">Subscription: Auto Collect Payments</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_collect_payments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <record id="cron_retry_failed_subscription_billing" model="ir.cron">
            <field name="name">Subscription: Retry Failed Billing</field>
            <field name="model_id" ref="model_subscription_billing_attempt"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed_billing_attempts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(minute=15, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <record id="cron_post_subscription_revenue_recognition" model="ir.cron">
            <field name="name">Subscription: Post Revenue Recognition</field>
            <field name="model_id" ref="model_subscription_deferred_revenue_recognition_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_scheduled_recognition()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <record id="cron_send_subscription_operation_digest" model="ir.cron">
            <field name="name">Subscription: Send Operations Digest</field>
            <field name="model_id" ref="model_subscription_operation_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_daily_digest()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="cron_cleanup_subscription_operation_runs" model="ir.cron">
            <field name="name">Subscription: Cleanup Operation Runs</field>
            <field name="model_id" ref="model_subscription_operation_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_operation_runs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
