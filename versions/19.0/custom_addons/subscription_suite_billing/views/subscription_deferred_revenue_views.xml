<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_deferred_revenue_list" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.list</field>
        <field name="model">subscription.deferred.revenue</field>
        <field name="arch" type="xml">
            <list string="Deferred Revenue Schedules" create="0" decoration-danger="state == 'blocked'" decoration-muted="state == 'cancelled'" decoration-success="state == 'ready'">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="subscription_plan_id"/>
                <field name="service_period_start"/>
                <field name="service_period_end"/>
                <field name="recognition_method"/>
                <field name="state" widget="badge" decoration-danger="state == 'blocked'" decoration-success="state == 'ready'" decoration-muted="state == 'cancelled'"/>
                <field name="amount_total" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_form" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.form</field>
        <field name="model">subscription.deferred.revenue</field>
        <field name="arch" type="xml">
            <form string="Deferred Revenue Schedule" create="0" edit="0">
                <header>
                    <button name="action_preview_recognition" type="object" string="Preview Recognition" class="btn-secondary" invisible="state != 'ready'"/>
                    <button name="action_regenerate_lines" type="object" string="Regenerate Draft Lines" class="btn-primary" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Cancel Schedule" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                        <button name="action_view_subscription" type="object" class="oe_stat_button" icon="fa-repeat">
                            <field name="amount_total" widget="statinfo" string="Amount"/>
                        </button>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Deferred revenue schedules are generated audit records. This foundation does not post journal entries or alter invoice accounting.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="invoice_id"/>
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                            <field name="subscription_plan_id"/>
                        </group>
                        <group>
                            <field name="service_period_start"/>
                            <field name="service_period_end"/>
                            <field name="recognition_method"/>
                            <field name="invoice_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <field name="amount_total" widget="monetary"/>
                        <field name="recognized_amount" widget="monetary"/>
                        <field name="remaining_amount" widget="monetary"/>
                    </group>
                    <group string="Configuration Snapshot">
                        <field name="deferred_revenue_account_id"/>
                        <field name="revenue_account_id"/>
                        <field name="recognition_journal_id"/>
                    </group>
                    <group string="Blocked Reason" invisible="state != 'blocked'">
                        <field name="block_reason" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Recognition Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="period_start"/>
                                    <field name="period_end"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                    <field name="recognized_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_search" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.search</field>
        <field name="model">subscription.deferred.revenue</field>
        <field name="arch" type="xml">
            <search string="Deferred Revenue Schedules">
                <field name="name"/>
                <field name="invoice_id"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="subscription_plan_id"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Blocked" name="blocked" domain="[('state', '=', 'blocked')]"/>
                <filter string="Missing Configuration" name="missing_configuration" domain="[('state', '=', 'blocked'), ('block_reason', 'ilike', 'configuration')]"/>
                <filter string="Missing Period" name="missing_period" domain="[('state', '=', 'blocked'), ('block_reason', 'ilike', 'period')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Straight-line Daily" name="straight_line_daily" domain="[('recognition_method', '=', 'straight_line_daily')]"/>
                <filter string="Equal Monthly" name="equal_monthly" domain="[('recognition_method', '=', 'equal_monthly')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'subscription_plan_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Method" name="group_method" context="{'group_by': 'recognition_method'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_deferred_revenue" model="ir.actions.act_window">
        <field name="name">Deferred Revenue</field>
        <field name="res_model">subscription.deferred.revenue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_ready': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate deferred revenue schedules from posted subscription invoices.</p>
            <p>Schedules are audit records for recognition planning. Journal posting is deferred to a later Phase 7 slice.</p>
        </field>
    </record>

    <record id="view_move_form_inherit_subscription_deferred_revenue" model="ir.ui.view">
        <field name="name">account.move.form.subscription.deferred.revenue</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_deferred_revenue_schedules" type="object" class="oe_stat_button" icon="fa-calendar" invisible="not subscription_id">
                    <field name="deferred_revenue_schedule_count" widget="statinfo" string="Deferred Revenue"/>
                </button>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_subscription_deferred_revenue"
              name="Deferred Revenue"
              parent="menu_subscription_billing"
              action="action_subscription_deferred_revenue"
              sequence="50"/>
</odoo>
