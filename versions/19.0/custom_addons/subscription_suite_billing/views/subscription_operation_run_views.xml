<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_operation_run_list" model="ir.ui.view">
        <field name="name">subscription.operation.run.list</field>
        <field name="model">subscription.operation.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'partial'">
                <field name="started_at"/>
                <field name="operation_type"/>
                <field name="trigger"/>
                <field name="state" widget="badge"/>
                <field name="processed_count"/>
                <field name="success_count"/>
                <field name="failed_count"/>
                <field name="skipped_count"/>
                <field name="duration_seconds"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_operation_run_form" model="ir.ui.view">
        <field name="name">subscription.operation.run.form</field>
        <field name="model">subscription.operation.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed"
                            class="btn-primary"
                            groups="subscription_suite.group_subscription_manager"
                            invisible="reviewed or state not in ['failed', 'partial']"/>
                    <button name="action_reopen_review" type="object" string="Reopen Review"
                            groups="subscription_suite.group_subscription_manager"
                            invisible="not reviewed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_billing_runs" type="object" class="oe_stat_button"
                                icon="fa-list" invisible="not billing_run_ids">
                            <field name="billing_run_ids" widget="statinfo" string="Billing Runs"/>
                        </button>
                        <button name="action_view_billing_attempts" type="object" class="oe_stat_button"
                                icon="fa-refresh" invisible="not billing_attempt_ids">
                            <field name="billing_attempt_ids" widget="statinfo" string="Billing Attempts"/>
                        </button>
                        <button name="action_view_payment_attempts" type="object" class="oe_stat_button"
                                icon="fa-credit-card" invisible="not payment_attempt_ids">
                            <field name="payment_attempt_ids" widget="statinfo" string="Payment Attempts"/>
                        </button>
                        <button name="action_view_recognition_runs" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not recognition_run_ids">
                            <field name="recognition_run_ids" widget="statinfo" string="Recognition Runs"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="operation_type"/>
                            <field name="trigger"/>
                            <field name="state" widget="badge"/>
                            <field name="reviewed"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_seconds"/>
                            <field name="reviewed_by_id" invisible="not reviewed"/>
                            <field name="reviewed_at" invisible="not reviewed"/>
                        </group>
                    </group>
                    <group string="Outcome" col="4">
                        <field name="processed_count"/>
                        <field name="success_count"/>
                        <field name="failed_count"/>
                        <field name="skipped_count"/>
                    </group>
                    <group string="Errors" invisible="not error_summary">
                        <field name="error_summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_operation_run_search" model="ir.ui.view">
        <field name="name">subscription.operation.run.search</field>
        <field name="model">subscription.operation.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Partial" name="partial" domain="[('state', '=', 'partial')]"/>
                <filter string="Needs Review" name="needs_review"
                        domain="[('state', 'in', ['failed', 'partial']), ('reviewed', '=', False)]"/>
                <filter string="Reviewed" name="reviewed" domain="[('reviewed', '=', True)]"/>
                <filter string="Recent" name="recent"
                        domain="[('started_at', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Operation" name="group_operation" context="{'group_by': 'operation_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_operation_run" model="ir.actions.act_window">
        <field name="name">Operational Runs</field>
        <field name="res_model">subscription.operation.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_operation_run_search"/>
        <field name="context">{'search_default_recent': 1}</field>
        <field name="help" type="html">
            <p>Operational runs summarize scheduled subscription work. Detailed attempts and accounting records remain the authoritative audit trail.</p>
        </field>
    </record>

    <menuitem id="menu_subscription_operation_run"
              name="Operational Runs"
              parent="subscription_suite_billing.menu_subscription_operations"
              action="action_subscription_operation_run"
              groups="subscription_suite.group_subscription_user,account.group_account_readonly"
              sequence="20"/>
</odoo>
