<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="subscription_manager_operation_dashboard_main" model="subscription.manager.operation.dashboard">
        <field name="name">Manager Operations Dashboard</field>
    </record>

    <record id="view_subscription_manager_operation_dashboard_form" model="ir.ui.view">
        <field name="name">subscription.manager.operation.dashboard.form</field>
        <field name="model">subscription.manager.operation.dashboard</field>
        <field name="arch" type="xml">
            <form string="Operations Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Operations Dashboard</h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_all" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="total_open_count" widget="statinfo" string="Open Items"/>
                        </button>
                        <button name="action_open_pending_requests" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_request_count" widget="statinfo" string="Pending Requests"/>
                        </button>
                        <button name="action_open_critical" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="critical_count" widget="statinfo" string="Critical"/>
                        </button>
                        <button name="action_open_oldest_pending" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="oldest_pending_age_days" widget="statinfo" string="Oldest Age"/>
                        </button>
                    </div>
                    <group string="Customer Requests">
                        <button name="action_open_pending_plan_changes" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="pending_plan_change_count" widget="statinfo" string="Plan Changes"/>
                        </button>
                        <button name="action_open_pending_lifecycle" type="object" class="oe_stat_button" icon="fa-pause-circle">
                            <field name="pending_lifecycle_count" widget="statinfo" string="Lifecycle"/>
                        </button>
                        <button name="action_open_pending_cancellations" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="pending_cancellation_count" widget="statinfo" string="Cancellations"/>
                        </button>
                    </group>
                    <group string="Billing Recovery">
                        <button name="action_open_failed_billing" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="failed_billing_count" widget="statinfo" string="Failed Billing"/>
                        </button>
                    </group>
                    <group string="Operational Health">
                        <button name="action_open_failed_operation_runs" type="object" class="oe_stat_button" icon="fa-times-circle">
                            <field name="failed_operation_run_count" widget="statinfo" string="Failed Runs"/>
                        </button>
                        <button name="action_open_partial_operation_runs" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                            <field name="partial_operation_run_count" widget="statinfo" string="Partial Runs"/>
                        </button>
                        <button name="action_open_recent_operation_failures" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="recent_operation_failure_count" widget="statinfo" string="Recent Failures"/>
                        </button>
                        <button name="action_open_unresolved_operation_errors" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="unresolved_operation_error_count" widget="statinfo" string="Needs Review"/>
                        </button>
                    </group>
                    <group string="Oldest Pending Item" invisible="not oldest_operation_id">
                        <field name="oldest_operation_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_manager_operation_list" model="ir.ui.view">
        <field name="name">subscription.manager.operation.list</field>
        <field name="model">subscription.manager.operation</field>
        <field name="arch" type="xml">
            <list string="Manager Operations" create="0" edit="0"
                  decoration-danger="priority == 'critical'"
                  decoration-warning="priority == 'high'"
                  decoration-info="priority == 'normal'">
                <field name="priority" widget="badge"
                       decoration-danger="priority == 'critical'"
                       decoration-warning="priority == 'high'"
                       decoration-info="priority == 'normal'"/>
                <field name="operation_type" widget="badge"/>
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <field name="action_state" widget="badge"
                       decoration-info="action_state == 'pending'"
                       decoration-danger="action_state == 'failed'"/>
                <field name="event_date"/>
                <field name="age_days"/>
                <field name="amount" widget="monetary"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_manager_operation_form" model="ir.ui.view">
        <field name="name">subscription.manager.operation.form</field>
        <field name="model">subscription.manager.operation</field>
        <field name="arch" type="xml">
            <form string="Manager Operation" create="0" edit="0">
                <header>
                    <button name="action_open_source" type="object" string="Open Source" class="btn-primary"/>
                    <button name="action_open_subscription" type="object" string="Open Subscription"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="operation_type"/>
                            <field name="priority"/>
                            <field name="action_state"/>
                            <field name="event_date"/>
                            <field name="age_days"/>
                        </group>
                        <group>
                            <field name="subscription_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Source">
                        <field name="source_reference"/>
                        <field name="source_model"/>
                        <field name="source_res_id"/>
                    </group>
                    <group string="Note">
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_manager_operation_search" model="ir.ui.view">
        <field name="name">subscription.manager.operation.search</field>
        <field name="model">subscription.manager.operation</field>
        <field name="arch" type="xml">
            <search string="Manager Operations">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="partner_id"/>
                <filter string="Pending Requests" name="pending_requests"
                        domain="[('action_state', '=', 'pending')]"/>
                <filter string="Plan Changes" name="plan_changes"
                        domain="[('operation_type', '=', 'plan_change'), ('action_state', '=', 'pending')]"/>
                <filter string="Lifecycle" name="lifecycle"
                        domain="[('operation_type', '=', 'lifecycle'), ('action_state', '=', 'pending')]"/>
                <filter string="Cancellations" name="cancellations"
                        domain="[('operation_type', '=', 'cancellation'), ('action_state', '=', 'pending')]"/>
                <filter string="Billing Recovery" name="billing_recovery"
                        domain="[('operation_type', '=', 'billing_recovery')]"/>
                <filter string="Critical" name="critical"
                        domain="[('priority', '=', 'critical')]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'operation_type'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_manager_operation_dashboard" model="ir.actions.act_window">
        <field name="name">Operations Dashboard</field>
        <field name="res_model">subscription.manager.operation.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="subscription_manager_operation_dashboard_main"/>
        <field name="target">current</field>
    </record>

    <record id="action_subscription_manager_operation" model="ir.actions.act_window">
        <field name="name">Manager Operations</field>
        <field name="res_model">subscription.manager.operation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_manager_operation_search"/>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pending customer requests and failed billing recovery items will appear here.
            </p>
        </field>
    </record>

    <menuitem id="menu_subscription_operations"
              name="Operations"
              parent="subscription_suite.menu_subscription_root"
              groups="subscription_suite.group_subscription_manager"
              sequence="15"/>

    <menuitem id="menu_subscription_manager_operation"
              name="Manager Operations"
              parent="menu_subscription_operations"
              action="action_subscription_manager_operation"
              sequence="10"/>

    <menuitem id="menu_subscription_manager_operation_dashboard"
              name="Operations Dashboard"
              parent="menu_subscription_operations"
              action="action_subscription_manager_operation_dashboard"
              sequence="5"/>
</odoo>
