<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_data_operation_list" model="ir.ui.view">
        <field name="name">subscription.data.operation.list</field>
        <field name="model">subscription.data.operation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'partial'">
                <field name="started_at"/>
                <field name="operation_type"/>
                <field name="mode"/>
                <field name="state" widget="badge"/>
                <field name="processed_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="warning_count"/>
                <field name="failed_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_data_operation_form" model="ir.ui.view">
        <field name="name">subscription.data.operation.form</field>
        <field name="model">subscription.data.operation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_view_lines" type="object" string="Review Rows" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="operation_type"/>
                            <field name="mode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="validation_run_id" invisible="not validation_run_id"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="source_filename" invisible="not source_filename"/>
                            <field name="source_hash" invisible="not source_hash"/>
                            <field name="date_from" invisible="not date_from"/>
                            <field name="date_to" invisible="not date_to"/>
                        </group>
                    </group>
                    <group string="Results" col="6">
                        <field name="processed_count"/>
                        <field name="created_count"/>
                        <field name="updated_count"/>
                        <field name="skipped_count"/>
                        <field name="warning_count"/>
                        <field name="failed_count"/>
                    </group>
                    <group string="Schema Error" invisible="not schema_error">
                        <field name="schema_error" nolabel="1"/>
                    </group>
                    <group string="Error Report" invisible="not error_report">
                        <field name="error_report" filename="error_report_filename"/>
                        <field name="error_report_filename" invisible="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0"
                              decoration-danger="outcome == 'failed'"
                              decoration-warning="outcome == 'warning'">
                            <field name="row_number"/>
                            <field name="external_reference"/>
                            <field name="outcome" widget="badge"/>
                            <field name="message"/>
                            <field name="target_model" optional="hide"/>
                            <field name="target_res_id" optional="hide"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_data_operation_line_list" model="ir.ui.view">
        <field name="name">subscription.data.operation.line.list</field>
        <field name="model">subscription.data.operation.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="outcome == 'failed'"
                  decoration-warning="outcome == 'warning'">
                <field name="operation_id"/>
                <field name="row_number"/>
                <field name="external_reference"/>
                <field name="outcome" widget="badge"/>
                <field name="message"/>
                <button name="action_open_target" type="object" string="Open"
                        icon="fa-external-link" invisible="not target_res_id"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_data_operation_search" model="ir.ui.view">
        <field name="name">subscription.data.operation.search</field>
        <field name="model">subscription.data.operation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_filename"/>
                <field name="source_hash"/>
                <filter string="Failures" name="failures" domain="[('failed_count', '&gt;', 0)]"/>
                <filter string="Warnings" name="warnings" domain="[('warning_count', '&gt;', 0)]"/>
                <filter string="Applied" name="applied" domain="[('mode', '=', 'apply')]"/>
                <group>
                    <filter string="Operation" name="group_operation" context="{'group_by': 'operation_type'}"/>
                    <filter string="Mode" name="group_mode" context="{'group_by': 'mode'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_subscription_data_operation_wizard_form" model="ir.ui.view">
        <field name="name">subscription.data.operation.wizard.form</field>
        <field name="model">subscription.data.operation.wizard</field>
        <field name="arch" type="xml">
            <form string="Subscription Data Operation">
                <group>
                    <field name="operation_type"/>
                    <field name="mode"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="source_file" filename="source_filename"
                           invisible="operation_type in ['mrr_backfill', 'billing_attempt_backfill']"/>
                    <field name="source_filename" invisible="1"/>
                    <field name="validation_run_id"
                           invisible="mode != 'apply' or operation_type in ['mrr_backfill', 'billing_attempt_backfill']"
                           required="mode == 'apply' and operation_type not in ['mrr_backfill', 'billing_attempt_backfill']"/>
                    <field name="date_from" invisible="operation_type != 'billing_attempt_backfill'"
                           required="operation_type == 'billing_attempt_backfill'"/>
                    <field name="date_to" invisible="operation_type != 'billing_attempt_backfill'"
                           required="operation_type == 'billing_attempt_backfill'"/>
                </group>
                <footer>
                    <button name="action_execute" type="object" string="Run" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_data_operation" model="ir.actions.act_window">
        <field name="name">Data Operations</field>
        <field name="res_model">subscription.data.operation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_data_operation_search"/>
    </record>

    <record id="action_run_subscription_data_operation" model="ir.actions.act_window">
        <field name="name">Run Data Operation</field>
        <field name="res_model">subscription.data.operation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_subscription_data_operations"
              name="Data Operations"
              parent="subscription_suite.menu_subscription_configuration"
              action="action_subscription_data_operation"
              groups="subscription_suite.group_subscription_manager"
              sequence="80"/>
    <menuitem id="menu_run_subscription_data_operation"
              name="Run Data Operation"
              parent="subscription_suite.menu_subscription_configuration"
              action="action_run_subscription_data_operation"
              groups="subscription_suite.group_subscription_manager"
              sequence="81"/>
</odoo>
