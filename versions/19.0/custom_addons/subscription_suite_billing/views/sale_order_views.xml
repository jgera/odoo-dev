<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for stat button (must be defined before the view that references it) -->
    <record id="action_subscription_proration" model="ir.actions.act_window">
        <field name="name">Prorations</field>
        <field name="res_model">subscription.proration</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('subscription_id', '=', active_id)]</field>
    </record>

    <record id="view_order_form_inherit_subscription_billing" model="ir.ui.view">
        <field name="name">sale.order.form.subscription.billing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="subscription_suite.view_order_form_inherit_subscription"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_pause_subscription']" position="before">
                <button name="action_change_plan" type="object" string="Change Plan" 
                        class="oe_highlight" invisible="subscription_state != 'active'"/>
                <button name="action_change_seats" type="object" string="Change Seats"
                        invisible="not is_subscription or seat_quantity &lt;= 0 or subscription_state not in ('active', 'paused', 'past_due')"/>
                <button name="action_cancel_pending_seat_change" type="object" string="Cancel Seat Change"
                        invisible="not pending_seat_change_date"/>
                <button name="action_change_addons" type="object" string="Change Add-ons"
                        invisible="not is_subscription or subscription_state not in ('active', 'paused', 'past_due')"/>
                <button name="action_cancel_pending_addon_change" type="object" string="Cancel Add-on Change"
                        invisible="not pending_addon_change_date"/>
                <button name="action_cancel_pending_plan_change" type="object" string="Cancel Plan Change"
                        invisible="not pending_plan_change_id"/>
            </xpath>

            <xpath expr="//field[@name='subscription_plan_id']" position="after">
                <field name="pending_plan_change_id" invisible="not pending_plan_change_id" readonly="1"/>
                <field name="pending_plan_change_date" invisible="not pending_plan_change_id" readonly="1"/>
                <field name="pending_plan_change_type" invisible="not pending_plan_change_id" readonly="1"/>
                <field name="pending_seat_quantity" invisible="not pending_seat_change_date" readonly="1"/>
                <field name="pending_seat_change_date" invisible="not pending_seat_change_date" readonly="1"/>
                <field name="pending_addon_change_operation" invisible="not pending_addon_change_date" readonly="1"/>
                <field name="pending_addon_product_id" invisible="not pending_addon_change_date" readonly="1"/>
                <field name="pending_addon_line_id" invisible="not pending_addon_change_date" readonly="1"/>
                <field name="pending_addon_quantity" invisible="not pending_addon_change_date" readonly="1"/>
                <field name="pending_addon_change_date" invisible="not pending_addon_change_date" readonly="1"/>
            </xpath>
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-list" name="action_view_billing_attempts" type="object" invisible="not is_subscription">
                    <field name="billing_attempt_count" widget="statinfo" string="Billing"/>
                </button>
                <button class="oe_stat_button" icon="fa-credit-card" name="action_view_payment_attempts" type="object" invisible="not is_subscription">
                    <field name="payment_attempt_count" widget="statinfo" string="Payments"/>
                </button>
                <button class="oe_stat_button" icon="fa-calculator" name="%(subscription_suite_billing.action_subscription_proration)d" type="action" invisible="not is_subscription">
                    <field name="proration_count" widget="statinfo" string="Prorations"/>
                </button>
                <button class="oe_stat_button" icon="fa-check-square-o" name="action_view_subscription_plan_change_requests" type="object" invisible="not is_subscription">
                    <field name="plan_change_request_count" widget="statinfo" string="Plan Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
