<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_change_seats_wizard_form" model="ir.ui.view">
        <field name="name">subscription.change.seats.wizard.form</field>
        <field name="model">subscription.change.seats.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Seats">
                <group>
                    <field name="subscription_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="current_seat_quantity"/>
                    <field name="new_seat_quantity"/>
                    <field name="effective_date"/>
                </group>
                <group string="Financial Impact">
                    <field name="current_mrr" widget="monetary"/>
                    <field name="new_mrr" widget="monetary"/>
                    <field name="net_amount" widget="monetary"/>
                    <field name="proration_preview" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm_change" type="object" string="Confirm Change" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
