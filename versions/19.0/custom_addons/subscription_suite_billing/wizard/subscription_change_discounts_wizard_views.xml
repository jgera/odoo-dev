<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_change_discounts_wizard_form" model="ir.ui.view">
        <field name="name">subscription.change.discounts.wizard.form</field>
        <field name="model">subscription.change.discounts.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Discounts">
                <group>
                    <field name="subscription_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="operation" widget="radio"/>
                    <field name="line_id" domain="[('order_id', '=', subscription_id), ('is_recurring', '=', True), ('display_type', '=', False)]"/>
                    <field name="base_discount"/>
                    <field name="promo_discount" invisible="operation == 'clear_promo'"/>
                    <field name="promo_start_date" invisible="operation == 'clear_promo'"/>
                    <field name="promo_end_date" invisible="operation == 'clear_promo'"/>
                </group>
                <group string="Impact">
                    <field name="current_effective_discount"/>
                    <field name="new_effective_discount"/>
                    <field name="current_mrr" widget="monetary"/>
                    <field name="new_mrr" widget="monetary"/>
                    <field name="impact_summary" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm_change" type="object" string="Confirm Change" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
