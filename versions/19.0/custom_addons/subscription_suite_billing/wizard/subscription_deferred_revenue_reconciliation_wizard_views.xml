<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_deferred_revenue_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.wizard.form</field>
        <field name="model">subscription.deferred.revenue.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Deferred Revenue Reconciliation">
                <sheet>
                    <p class="text-muted">
                        Generate audit rows from posted subscription invoices, deferred revenue schedules, recognized lines,
                        recognition journal entries, and credit-note adjustments. This action does not post or change accounting entries.
                    </p>
                    <group>
                        <group>
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="subscription_plan_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_subscription_deferred_revenue_reconciliation" model="ir.actions.act_window">
        <field name="name">Generate Deferred Revenue Reconciliation</field>
        <field name="res_model">subscription.deferred.revenue.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_generate_subscription_deferred_revenue_reconciliation"
              name="Generate Deferred Revenue Reconciliation"
              parent="menu_subscription_billing"
              action="action_generate_subscription_deferred_revenue_reconciliation"
              sequence="61"
              groups="subscription_suite.group_subscription_manager"/>
</odoo>
