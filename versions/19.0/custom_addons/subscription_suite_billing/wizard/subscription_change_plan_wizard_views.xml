<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_change_plan_wizard_form" model="ir.ui.view">
        <field name="name">subscription.change.plan.wizard.form</field>
        <field name="model">subscription.change.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Subscription Plan">
                <group>
                    <field name="subscription_id" invisible="1"/>
                    <field name="available_plan_ids" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="current_plan_id"/>
                    <field name="new_plan_id" domain="[('id', 'in', available_plan_ids)]" options="{'no_create': True}"/>
                    <field name="change_timing" widget="radio"/>
                    <field name="effective_date" readonly="change_timing == 'next_period'"/>
                    <field name="change_type" invisible="not new_plan_id"/>
                </group>
                
                <group string="Financial Impact" invisible="not new_plan_id">
                    <field name="proration_preview" nolabel="1" colspan="2"/>
                </group>

                <footer>
                    <button name="action_confirm_change" type="object" string="Confirm Change" class="btn-primary" invisible="not new_plan_id"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
