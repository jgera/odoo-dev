<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.custom.payment</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="after">
                <block title="Smart Payment Defaults" id="custom_payment_adjustments_settings">
                    <setting id="default_payment_zero_setting" help="Default the payment amount to 0.0 in the register payment wizard.">
                        <field name="is_payment_zero_default"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
