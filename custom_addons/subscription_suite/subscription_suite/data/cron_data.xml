<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Generate Invoices Cron -->
        <record id="cron_generate_subscription_invoices" model="ir.cron">
            <field name="name">Subscription: Generate Recurring Invoices</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_subscription_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <!-- Check Trial Expiry Cron -->
        <record id="cron_check_trial_expiry" model="ir.cron">
            <field name="name">Subscription: Check Trial Expiry</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_trial_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <!-- Check Subscription Expiry Cron -->
        <record id="cron_check_subscription_expiry" model="ir.cron">
            <field name="name">Subscription: Check Subscription Expiry</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_subscription_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=30, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>

        <!-- Process Scheduled Cancellations Cron -->
        <record id="cron_process_scheduled_cancellations" model="ir.cron">
            <field name="name">Subscription: Process Scheduled Cancellations</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_scheduled_cancellations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=7, minute=45, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
