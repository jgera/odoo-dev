<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_mrr_movement_anomaly_list" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.list</field>
        <field name="model">subscription.mrr.movement.anomaly</field>
        <field name="arch" type="xml">
            <list string="MRR Movement Anomalies" create="0" edit="0" delete="0"
                  decoration-warning="anomaly_type == 'movement_only'"
                  decoration-danger="anomaly_type == 'missing_plan'">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="anomaly_type"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="movement_count" sum="Movements"/>
                <field name="net_movement_mrr" sum="Net Movement"/>
                <field name="new_mrr" sum="New MRR"/>
                <field name="expansion_mrr" sum="Expansion MRR"/>
                <field name="contraction_mrr" sum="Contraction MRR"/>
                <field name="churned_mrr" sum="Churned MRR"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_anomaly_form" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.form</field>
        <field name="model">subscription.mrr.movement.anomaly</field>
        <field name="arch" type="xml">
            <form string="MRR Movement Anomaly" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_movements" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="movement_count" widget="statinfo" string="Movements"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                            <field name="anomaly_type"/>
                            <field name="bucket_key"/>
                            <field name="generated_at"/>
                        </group>
                        <group>
                            <field name="subscription_plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Movement Buckets">
                        <field name="movement_count"/>
                        <field name="new_mrr" widget="monetary"/>
                        <field name="expansion_mrr" widget="monetary"/>
                        <field name="contraction_mrr" widget="monetary"/>
                        <field name="churned_mrr" widget="monetary"/>
                        <field name="net_movement_mrr" widget="monetary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_anomaly_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.pivot</field>
        <field name="model">subscription.mrr.movement.anomaly</field>
        <field name="arch" type="xml">
            <pivot string="MRR Movement Anomalies" sample="1">
                <field name="closing_date" type="row" interval="month"/>
                <field name="anomaly_type" type="col"/>
                <field name="movement_count" type="measure"/>
                <field name="net_movement_mrr" type="measure"/>
                <field name="new_mrr" type="measure"/>
                <field name="expansion_mrr" type="measure"/>
                <field name="contraction_mrr" type="measure"/>
                <field name="churned_mrr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_anomaly_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.graph</field>
        <field name="model">subscription.mrr.movement.anomaly</field>
        <field name="arch" type="xml">
            <graph string="MRR Movement Anomalies" type="bar" sample="1">
                <field name="closing_date" interval="month"/>
                <field name="anomaly_type"/>
                <field name="net_movement_mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_anomaly_search" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.search</field>
        <field name="model">subscription.mrr.movement.anomaly</field>
        <field name="arch" type="xml">
            <search string="MRR Movement Anomalies">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <filter string="Movement Only" name="movement_only" domain="[('anomaly_type', '=', 'movement_only')]"/>
                <filter string="Missing Plan" name="missing_plan" domain="[('anomaly_type', '=', 'missing_plan')]"/>
                <separator/>
                <filter string="Closing Month" name="group_closing_month" context="{'group_by':'closing_date:month'}"/>
                <filter string="Anomaly Type" name="group_anomaly_type" context="{'group_by':'anomaly_type'}"/>
                <filter string="Plan" name="group_plan_id" context="{'group_by':'subscription_plan_id'}"/>
                <filter string="Currency" name="group_currency_id" context="{'group_by':'currency_id'}"/>
                <filter string="Company" name="group_company_id" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_subscription_mrr_movement_anomaly_generate_wizard_form" model="ir.ui.view">
        <field name="name">subscription.mrr.movement.anomaly.generate.wizard.form</field>
        <field name="model">subscription.mrr.movement.anomaly.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate MRR Movement Anomalies">
                <group>
                    <field name="opening_date"/>
                    <field name="closing_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="subscription_plan_id"/>
                </group>
                <footer>
                    <button name="action_generate_anomalies" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_mrr_movement_anomaly_report" model="ir.actions.act_window">
        <field name="name">MRR Movement Anomalies</field>
        <field name="res_model">subscription.mrr.movement.anomaly</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_closing_month': 1, 'search_default_group_anomaly_type': 1}</field>
    </record>

    <record id="action_generate_subscription_mrr_movement_anomaly" model="ir.actions.act_window">
        <field name="name">Generate MRR Movement Anomalies</field>
        <field name="res_model">subscription.mrr.movement.anomaly.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
