<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_churn_reason_summary_list" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.list</field>
        <field name="model">subscription.churn.reason.summary</field>
        <field name="arch" type="xml">
            <list string="Churn Reasons" create="0" edit="0"
                  decoration-success="status == 'ready'"
                  decoration-warning="status == 'missing_reason'">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <field name="reason_bucket"/>
                <field name="cancellation_reason_id"/>
                <field name="status"/>
                <field name="churned_subscription_count" sum="Churned Subscriptions"/>
                <field name="churned_mrr" widget="monetary" sum="Churned MRR"/>
                <field name="average_churned_mrr" widget="monetary" avg="Average Churned MRR"/>
                <field name="feedback_count" sum="Feedback Count"/>
                <field name="feedback_coverage" avg="Feedback Coverage"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_churn_reason_summary_form" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.form</field>
        <field name="model">subscription.churn.reason.summary</field>
        <field name="arch" type="xml">
            <form string="Churn Reason Summary" create="0" edit="0">
                <header>
                    <button name="action_view_source_subscriptions" type="object" string="Subscriptions" class="btn-primary"/>
                    <button name="action_view_cancellation_requests" type="object" string="Cancellation Requests"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="churned_mrr" widget="monetary"/></h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="subscription_plan_id"/>
                            <field name="reason_bucket"/>
                            <field name="cancellation_reason_id"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ready'"
                                   decoration-warning="status == 'missing_reason'"/>
                            <field name="generated_at"/>
                        </group>
                    </group>
                    <group string="Churn">
                        <field name="churned_subscription_count"/>
                        <field name="churned_mrr" widget="monetary"/>
                        <field name="average_churned_mrr" widget="monetary"/>
                        <field name="feedback_count"/>
                        <field name="feedback_coverage"/>
                    </group>
                    <group string="Technical">
                        <field name="bucket_key"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_churn_reason_summary_pivot" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.pivot</field>
        <field name="model">subscription.churn.reason.summary</field>
        <field name="arch" type="xml">
            <pivot string="Churn Reasons" sample="1">
                <field name="cancellation_reason_id" type="row"/>
                <field name="subscription_plan_id" type="col"/>
                <field name="churned_subscription_count" type="measure"/>
                <field name="churned_mrr" type="measure"/>
                <field name="feedback_coverage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_churn_reason_summary_graph" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.graph</field>
        <field name="model">subscription.churn.reason.summary</field>
        <field name="arch" type="xml">
            <graph string="Churn Reasons" type="bar" sample="1">
                <field name="cancellation_reason_id"/>
                <field name="churned_subscription_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_churn_reason_summary_search" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.search</field>
        <field name="model">subscription.churn.reason.summary</field>
        <field name="arch" type="xml">
            <search string="Churn Reasons">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <field name="cancellation_reason_id"/>
                <field name="reason_bucket"/>
                <field name="status"/>
                <filter string="Ready" name="ready" domain="[('status', '=', 'ready')]"/>
                <filter string="Missing Reason" name="missing_reason" domain="[('status', '=', 'missing_reason')]"/>
                <filter string="All Reasons" name="all_reasons" domain="[('reason_bucket', '=', 'all_reasons')]"/>
                <group>
                    <filter string="Closing Date" name="group_closing_date" context="{'group_by': 'closing_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'subscription_plan_id'}"/>
                    <filter string="Reason" name="group_reason" context="{'group_by': 'cancellation_reason_id'}"/>
                    <filter string="Reason Bucket" name="group_reason_bucket" context="{'group_by': 'reason_bucket'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_subscription_churn_reason_summary_generate_wizard_form" model="ir.ui.view">
        <field name="name">subscription.churn.reason.summary.generate.wizard.form</field>
        <field name="model">subscription.churn.reason.summary.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Churn Reasons">
                <group>
                    <field name="opening_date"/>
                    <field name="closing_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="subscription_plan_id"/>
                    <field name="cancellation_reason_id"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_churn_reason_summary_report" model="ir.actions.act_window">
        <field name="name">Churn Reasons</field>
        <field name="res_model">subscription.churn.reason.summary</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_subscription_churn_reason_summary_search"/>
        <field name="context">{'search_default_group_reason': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate churn reason summaries from cancelled and expired subscriptions.
            </p>
        </field>
    </record>

    <record id="action_generate_subscription_churn_reason_summary" model="ir.actions.act_window">
        <field name="name">Generate Churn Reasons</field>
        <field name="res_model">subscription.churn.reason.summary.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
