<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_analytics_sequence_guide_form" model="ir.ui.view">
        <field name="name">subscription.analytics.sequence.guide.form</field>
        <field name="model">subscription.analytics.sequence.guide</field>
        <field name="arch" type="xml">
            <form string="Analytics Generation Guide" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="guide_text" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_analytics_sequence_guide" model="ir.actions.act_window">
        <field name="name">Analytics Generation Guide</field>
        <field name="res_model">subscription.analytics.sequence.guide</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
