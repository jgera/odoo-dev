<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_mrr_reconciliation_list" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.list</field>
        <field name="model">subscription.mrr.reconciliation</field>
        <field name="arch" type="xml">
            <list string="MRR Reconciliation" create="0" edit="0" delete="0"
                  decoration-success="status == 'matched'"
                  decoration-warning="status in ['missing_opening_snapshot', 'missing_closing_snapshot']"
                  decoration-danger="status == 'variance'">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="status"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="opening_mrr" sum="Opening MRR"/>
                <field name="closing_mrr" sum="Closing MRR"/>
                <field name="snapshot_delta_mrr" sum="Snapshot Delta"/>
                <field name="net_movement_mrr" sum="Net Movement"/>
                <field name="variance_mrr" sum="Variance"/>
                <field name="new_mrr" sum="New MRR"/>
                <field name="expansion_mrr" sum="Expansion MRR"/>
                <field name="contraction_mrr" sum="Contraction MRR"/>
                <field name="churned_mrr" sum="Churned MRR"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_mrr_reconciliation_form" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.form</field>
        <field name="model">subscription.mrr.reconciliation</field>
        <field name="arch" type="xml">
            <form string="MRR Reconciliation" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_snapshots" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <span>Snapshots</span>
                        </button>
                        <button name="action_view_movements" type="object" class="oe_stat_button" icon="fa-exchange">
                            <span>Movements</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                            <field name="status"/>
                            <field name="generated_at"/>
                        </group>
                        <group>
                            <field name="subscription_plan_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group string="Reconciliation">
                        <field name="opening_mrr" widget="monetary"/>
                        <field name="closing_mrr" widget="monetary"/>
                        <field name="snapshot_delta_mrr" widget="monetary"/>
                        <field name="net_movement_mrr" widget="monetary"/>
                        <field name="variance_mrr" widget="monetary"/>
                    </group>
                    <group string="Movement Buckets">
                        <field name="new_mrr" widget="monetary"/>
                        <field name="expansion_mrr" widget="monetary"/>
                        <field name="contraction_mrr" widget="monetary"/>
                        <field name="churned_mrr" widget="monetary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_mrr_reconciliation_pivot" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.pivot</field>
        <field name="model">subscription.mrr.reconciliation</field>
        <field name="arch" type="xml">
            <pivot string="MRR Reconciliation" sample="1">
                <field name="closing_date" type="row" interval="month"/>
                <field name="status" type="col"/>
                <field name="snapshot_delta_mrr" type="measure"/>
                <field name="net_movement_mrr" type="measure"/>
                <field name="variance_mrr" type="measure"/>
                <field name="new_mrr" type="measure"/>
                <field name="expansion_mrr" type="measure"/>
                <field name="contraction_mrr" type="measure"/>
                <field name="churned_mrr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_mrr_reconciliation_graph" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.graph</field>
        <field name="model">subscription.mrr.reconciliation</field>
        <field name="arch" type="xml">
            <graph string="MRR Reconciliation" type="bar" sample="1">
                <field name="closing_date" interval="month"/>
                <field name="status"/>
                <field name="variance_mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_subscription_mrr_reconciliation_search" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.search</field>
        <field name="model">subscription.mrr.reconciliation</field>
        <field name="arch" type="xml">
            <search string="MRR Reconciliation">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="subscription_plan_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <filter string="Matched" name="matched" domain="[('status', '=', 'matched')]"/>
                <filter string="Variance" name="variance" domain="[('status', '=', 'variance')]"/>
                <filter string="Missing Opening" name="missing_opening" domain="[('status', '=', 'missing_opening_snapshot')]"/>
                <filter string="Missing Closing" name="missing_closing" domain="[('status', '=', 'missing_closing_snapshot')]"/>
                <separator/>
                <filter string="Closing Month" name="group_closing_month" context="{'group_by':'closing_date:month'}"/>
                <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                <filter string="Plan" name="group_plan_id" context="{'group_by':'subscription_plan_id'}"/>
                <filter string="Currency" name="group_currency_id" context="{'group_by':'currency_id'}"/>
                <filter string="Company" name="group_company_id" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="view_subscription_mrr_reconciliation_generate_wizard_form" model="ir.ui.view">
        <field name="name">subscription.mrr.reconciliation.generate.wizard.form</field>
        <field name="model">subscription.mrr.reconciliation.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate MRR Reconciliation">
                <group>
                    <field name="opening_date"/>
                    <field name="closing_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="subscription_plan_id"/>
                </group>
                <footer>
                    <button name="action_generate_reconciliation" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_subscription_mrr_reconciliation_report" model="ir.actions.act_window">
        <field name="name">MRR Reconciliation</field>
        <field name="res_model">subscription.mrr.reconciliation</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_closing_month': 1, 'search_default_group_status': 1}</field>
    </record>

    <record id="action_generate_subscription_mrr_reconciliation" model="ir.actions.act_window">
        <field name="name">Generate MRR Reconciliation</field>
        <field name="res_model">subscription.mrr.reconciliation.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
