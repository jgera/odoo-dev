<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_subscription_billing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.subscription.billing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Subscriptions" data-string="Subscriptions" name="subscription_suite" groups="subscription_suite.group_subscription_manager">
                    <block title="Billing Recovery" name="subscription_billing_recovery_settings">
                        <setting id="subscription_billing_retry_policy" string="Retry Policy" help="Automatically retry temporary recurring billing failures before assigning manual recovery.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_max_attempts" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_max_attempts" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_delay_hours" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_delay_hours" class="oe_inline"/>
                                    <span class="ms-2">hours</span>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_batch_size" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_batch_size" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Revenue Recognition" name="subscription_revenue_recognition_settings">
                        <setting id="subscription_revenue_recognition" string="Deferred Revenue Schedules" help="Configure company-specific recognition defaults. Generated schedules, preview, manual posting, and scheduled posting use the invoice or schedule company configuration.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="subscription_deferred_revenue_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_deferred_revenue_account_id" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_revenue_account_id" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_revenue_account_id" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_recognition_journal_id" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_recognition_journal_id" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_default_recognition_method" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_default_recognition_method" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_enable_scheduled_recognition_posting" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_enable_scheduled_recognition_posting" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_scheduled_recognition_cutoff_rule" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_scheduled_recognition_cutoff_rule" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Operational Observability" name="subscription_operation_observability_settings">
                        <setting string="Daily Operations Digest"
                                 help="Queue a daily email only when failed or partial subscription operations require review. The scheduled action is disabled by default.">
                            <field name="subscription_operation_digest_enabled"/>
                            <div class="content-group" invisible="not subscription_operation_digest_enabled">
                                <label for="subscription_operation_digest_recipient_ids"/>
                                <field name="subscription_operation_digest_recipient_ids"
                                       widget="many2many_tags"
                                       domain="[('share', '=', False), ('company_ids', 'in', company_id)]"/>
                            </div>
                        </setting>
                        <setting string="Operation Run Retention"
                                 help="Delete successful and skipped run summaries after the retention period. Failed and partial runs are never removed automatically. The scheduled action is disabled by default.">
                            <field name="subscription_operation_cleanup_enabled"/>
                            <div class="content-group" invisible="not subscription_operation_cleanup_enabled">
                                <label for="subscription_operation_retention_days"/>
                                <field name="subscription_operation_retention_days" class="oe_inline"/>
                                <span class="ms-2">days</span>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_subscription_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_subscription_billing"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'subscription_suite', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_subscription_settings"
              name="Settings"
              parent="subscription_suite.menu_subscription_configuration"
              action="action_subscription_config_settings"
              groups="subscription_suite.group_subscription_manager"
              sequence="100"/>
</odoo>
