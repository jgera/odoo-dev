<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_subscription_billing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.subscription.billing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Subscriptions" data-string="Subscriptions" name="subscription_suite" groups="subscription_suite.group_subscription_manager">
                    <block title="Billing Recovery" name="subscription_billing_recovery_settings">
                        <setting id="subscription_billing_retry_policy" string="Retry Policy" help="Automatically retry temporary recurring billing failures before assigning manual recovery.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_max_attempts" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_max_attempts" class="oe_inline"/>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_delay_hours" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_delay_hours" class="oe_inline"/>
                                    <span class="ms-2">hours</span>
                                </div>
                                <div class="row mt8">
                                    <label for="subscription_billing_retry_batch_size" class="col-lg-5 o_light_label"/>
                                    <field name="subscription_billing_retry_batch_size" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_subscription_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_subscription_billing"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'subscription_suite', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_subscription_settings"
              name="Settings"
              parent="subscription_suite.menu_subscription_configuration"
              action="action_subscription_config_settings"
              groups="subscription_suite.group_subscription_manager"
              sequence="100"/>
</odoo>
