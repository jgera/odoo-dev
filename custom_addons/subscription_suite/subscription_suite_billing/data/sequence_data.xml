<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_subscription_billing_run" model="ir.sequence">
            <field name="name">Subscription Billing Run</field>
            <field name="code">subscription.billing.run</field>
            <field name="prefix">BRUN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_subscription_billing_attempt" model="ir.sequence">
            <field name="name">Subscription Billing Attempt</field>
            <field name="code">subscription.billing.attempt</field>
            <field name="prefix">BATT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_subscription_plan_change_request" model="ir.sequence">
            <field name="name">Subscription Plan Change Request</field>
            <field name="code">subscription.plan.change.request</field>
            <field name="prefix">PCR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
