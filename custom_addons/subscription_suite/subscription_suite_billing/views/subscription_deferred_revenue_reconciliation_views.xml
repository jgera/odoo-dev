<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_deferred_revenue_reconciliation_list" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.list</field>
        <field name="model">subscription.deferred.revenue.reconciliation</field>
        <field name="arch" type="xml">
            <list string="Deferred Revenue Reconciliation" create="0" edit="0"
                  decoration-danger="status in ('variance', 'missing_schedule', 'missing_journal_entry', 'blocked_schedule')"
                  decoration-success="status == 'ready'">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ready'"
                       decoration-danger="status in ('variance', 'missing_schedule', 'missing_journal_entry', 'blocked_schedule')"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <field name="invoice_deferred_amount" widget="monetary"/>
                <field name="schedule_amount" widget="monetary"/>
                <field name="recognized_line_amount" widget="monetary"/>
                <field name="posted_journal_amount" widget="monetary"/>
                <field name="credit_note_adjustment_amount" widget="monetary"/>
                <field name="remaining_deferred_amount" widget="monetary"/>
                <field name="variance_amount" widget="monetary"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_reconciliation_form" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.form</field>
        <field name="model">subscription.deferred.revenue.reconciliation</field>
        <field name="arch" type="xml">
            <form string="Deferred Revenue Reconciliation" create="0" edit="0">
                <header>
                    <button name="action_view_invoices" type="object" string="Invoices" class="btn-secondary"/>
                    <button name="action_view_schedules" type="object" string="Schedules" class="btn-secondary"/>
                    <button name="action_view_recognition_lines" type="object" string="Recognition Lines" class="btn-secondary"/>
                    <button name="action_view_recognition_moves" type="object" string="Journal Entries" class="btn-secondary"/>
                    <button name="action_view_credit_notes" type="object" string="Credit Notes" class="btn-secondary"/>
                    <button name="action_view_adjustments" type="object" string="Adjustments" class="btn-secondary"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="opening_date"/>
                            <field name="closing_date"/>
                            <field name="generated_at"/>
                            <field name="bucket_key"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                            <field name="subscription_plan_id"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <field name="invoice_deferred_amount" widget="monetary"/>
                        <field name="schedule_amount" widget="monetary"/>
                        <field name="recognized_line_amount" widget="monetary"/>
                        <field name="posted_journal_amount" widget="monetary"/>
                        <field name="credit_note_adjustment_amount" widget="monetary"/>
                        <field name="remaining_deferred_amount" widget="monetary"/>
                        <field name="variance_amount" widget="monetary"/>
                    </group>
                    <group string="Source Counts">
                        <field name="invoice_count"/>
                        <field name="schedule_count"/>
                        <field name="recognized_line_count"/>
                        <field name="recognition_move_count"/>
                        <field name="adjustment_count"/>
                    </group>
                    <notebook>
                        <page string="Invoices">
                            <field name="invoice_ids" readonly="1"/>
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids" readonly="1"/>
                        </page>
                        <page string="Recognition Lines">
                            <field name="recognition_line_ids" readonly="1"/>
                        </page>
                        <page string="Journal Entries">
                            <field name="recognition_move_ids" readonly="1"/>
                        </page>
                        <page string="Credit Notes">
                            <field name="credit_note_ids" readonly="1"/>
                        </page>
                        <page string="Adjustments">
                            <field name="adjustment_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_reconciliation_search" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.search</field>
        <field name="model">subscription.deferred.revenue.reconciliation</field>
        <field name="arch" type="xml">
            <search string="Deferred Revenue Reconciliation">
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="subscription_plan_id"/>
                <filter string="Ready" name="ready" domain="[('status', '=', 'ready')]"/>
                <filter string="Variance" name="variance" domain="[('status', '=', 'variance')]"/>
                <filter string="Missing Schedule" name="missing_schedule" domain="[('status', '=', 'missing_schedule')]"/>
                <filter string="Missing Journal Entry" name="missing_journal_entry" domain="[('status', '=', 'missing_journal_entry')]"/>
                <filter string="Blocked Schedule" name="blocked_schedule" domain="[('status', '=', 'blocked_schedule')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Closing Date" name="group_closing_date" context="{'group_by': 'closing_date'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'subscription_plan_id'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_reconciliation_pivot" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.pivot</field>
        <field name="model">subscription.deferred.revenue.reconciliation</field>
        <field name="arch" type="xml">
            <pivot string="Deferred Revenue Reconciliation">
                <field name="closing_date" type="row"/>
                <field name="subscription_plan_id" type="row"/>
                <field name="currency_id" type="col"/>
                <field name="invoice_deferred_amount" type="measure"/>
                <field name="schedule_amount" type="measure"/>
                <field name="recognized_line_amount" type="measure"/>
                <field name="posted_journal_amount" type="measure"/>
                <field name="credit_note_adjustment_amount" type="measure"/>
                <field name="remaining_deferred_amount" type="measure"/>
                <field name="variance_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_reconciliation_graph" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.reconciliation.graph</field>
        <field name="model">subscription.deferred.revenue.reconciliation</field>
        <field name="arch" type="xml">
            <graph string="Deferred Revenue Reconciliation" type="bar">
                <field name="closing_date"/>
                <field name="variance_amount" type="measure"/>
                <field name="remaining_deferred_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_subscription_deferred_revenue_reconciliation" model="ir.actions.act_window">
        <field name="name">Deferred Revenue Reconciliation</field>
        <field name="res_model">subscription.deferred.revenue.reconciliation</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Generate deferred revenue reconciliation rows for a finance period.</p>
            <p>Rows are generated audit records. They compare invoices, schedules, recognized lines, posted recognition entries, and credit-note adjustments without changing accounting data.</p>
        </field>
    </record>

    <menuitem id="menu_subscription_deferred_revenue_reconciliation"
              name="Deferred Revenue Reconciliation"
              parent="menu_subscription_billing"
              action="action_subscription_deferred_revenue_reconciliation"
              sequence="60"/>
</odoo>
