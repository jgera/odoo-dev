<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_plan_form_inherit_billing_approval" model="ir.ui.view">
        <field name="name">subscription.plan.form.billing.approval</field>
        <field name="model">subscription.plan</field>
        <field name="inherit_id" ref="subscription_suite.view_subscription_plan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='paths']/group" position="inside">
                <group string="Approvals">
                    <field name="approval_required_for_upgrade"/>
                    <field name="approval_required_for_downgrade"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='settings']/group" position="after">
                <group string="Usage Billing">
                    <field name="usage_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="meter_id"/>
                            <field name="included_quantity"/>
                            <field name="overage_product_id"/>
                            <field name="overage_price_unit" widget="monetary"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
