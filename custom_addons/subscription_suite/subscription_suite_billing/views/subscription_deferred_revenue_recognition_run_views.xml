<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_deferred_revenue_recognition_run_list" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.recognition.run.list</field>
        <field name="model">subscription.deferred.revenue.recognition.run</field>
        <field name="arch" type="xml">
            <list string="Recognition Posting Runs" create="0" edit="0"
                  decoration-success="status == 'success'"
                  decoration-warning="status in ('partial', 'skipped')"
                  decoration-danger="status == 'failed'">
                <field name="run_datetime"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="cutoff_date"/>
                <field name="cutoff_rule"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status in ('partial', 'skipped')"
                       decoration-danger="status == 'failed'"/>
                <field name="created_move_count"/>
                <field name="recognized_line_count"/>
                <field name="skipped_schedule_count"/>
            </list>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_recognition_run_form" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.recognition.run.form</field>
        <field name="model">subscription.deferred.revenue.recognition.run</field>
        <field name="arch" type="xml">
            <form string="Recognition Posting Run" create="0" edit="0">
                <header>
                    <button name="action_view_moves" type="object" string="Journal Entries" class="btn-secondary" invisible="not move_ids"/>
                    <button name="action_view_lines" type="object" string="Recognized Lines" class="btn-secondary" invisible="not line_ids"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="run_datetime"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cutoff_date"/>
                            <field name="cutoff_rule"/>
                        </group>
                        <group string="Results">
                            <field name="created_move_count"/>
                            <field name="recognized_line_count"/>
                            <field name="skipped_schedule_count"/>
                        </group>
                    </group>
                    <group string="Errors / Skips" invisible="not error_notes">
                        <field name="error_notes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Journal Entries">
                            <field name="move_ids" readonly="1"/>
                        </page>
                        <page string="Recognized Lines">
                            <field name="line_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_deferred_revenue_recognition_run_search" model="ir.ui.view">
        <field name="name">subscription.deferred.revenue.recognition.run.search</field>
        <field name="model">subscription.deferred.revenue.recognition.run</field>
        <field name="arch" type="xml">
            <search string="Recognition Posting Runs">
                <field name="name"/>
                <field name="company_id"/>
                <field name="cutoff_date"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Partial" name="partial" domain="[('status', '=', 'partial')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Skipped" name="skipped" domain="[('status', '=', 'skipped')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Cutoff Date" name="group_cutoff" context="{'group_by': 'cutoff_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_deferred_revenue_recognition_run" model="ir.actions.act_window">
        <field name="name">Recognition Posting Runs</field>
        <field name="res_model">subscription.deferred.revenue.recognition.run</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Scheduled recognition posting runs appear here.</p>
            <p>Runs are audit records for the scheduled posting process. Enable scheduled posting in Subscription settings before the cron posts due recognition lines.</p>
        </field>
    </record>

    <menuitem id="menu_subscription_deferred_revenue_recognition_run"
              name="Recognition Posting Runs"
              parent="menu_subscription_billing"
              action="action_subscription_deferred_revenue_recognition_run"
              sequence="62"/>
</odoo>
