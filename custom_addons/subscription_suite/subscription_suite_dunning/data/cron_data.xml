<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dunning Process Cron -->
        <record id="cron_process_dunning" model="ir.cron">
            <field name="name">Subscription: Process Dunning Steps</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_dunning()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=9, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
