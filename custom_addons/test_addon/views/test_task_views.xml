<odoo>
    <!-- Tree View -->
    <record id="view_test_task_tree" model="ir.ui.view">
        <field name="name">test.task.tree</field>
        <field name="model">test.task</field>
        <field name="arch" type="xml">
            <tree string="Tasks">
                <field name="name"/>
                <field name="priority"/>
                <field name="is_done"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_test_task_form" model="ir.ui.view">
        <field name="name">test.task.form</field>
        <field name="model">test.task</field>
        <field name="arch" type="xml">
            <form string="Task">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="priority"/>
                        <field name="is_done"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_test_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">test.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_test_root" name="Test App" sequence="10"/>
    <menuitem id="menu_test_task" name="My Tasks" parent="menu_test_root" action="action_test_task"/>
</odoo>
